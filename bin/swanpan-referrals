#!/usr/bin/env bash
#
# swanpan-referrals -- render a "where did they actually come from" report.
#
# GoAccess has two referrer panels and they are NOT the same thing:
#   REFERRING_SITES  -> host only        (google.com)
#   REFERRERS        -> full URL         (google.com/search?q=...)
#
# REFERRERS is disabled in the shipped goaccess.conf (ignore-panel REFERRERS).
# This script enables it with --no-global-config so the local config cannot
# silently turn it back off.
#
# ---------------------------------------------------------------------------
# WHY THE SELF-REFERRAL FILTER IS DONE IN PYTHON, NOT --hide-referrer
#
# --hide-referrer is an EXACT match on the stored value. The REFERRERS panel
# stores the FULL URL, paths included, so there are unbounded distinct values
# (https://www.swanpan.io/store, /learn, /learn/1-2, ...). There is no fixed
# needle list that hides "our own site"; you would have to enumerate every path
# we ever build. Wildcards are documented for --ignore-referrer but not for
# --hide-referrer, and we have already been burned assuming they work.
#
# So: build the JSON with GoAccess (no referrer filtering at all), then filter
# by HOST in Python, which is exactly the rule we actually want -- "drop
# referers whose host is one of ours". Empty referers ("-") are kept and
# counted separately, because 'how much traffic arrived with no referer' is
# itself a meaningful number.
# ---------------------------------------------------------------------------
#
# Writes:
#   /var/www/traffic/referrals-<site>.html   served behind basic auth
# JSON is kept in a private state dir and is NOT served.

set -euo pipefail

LOG_DIR=/var/log/nginx
OUT=/var/www/traffic
STATE=/var/lib/swanpan-traffic-referrals
ORIGIN_IP=174.138.42.13

# Must match log_format 'swanpan'. %R is the referer, %u the user agent.
FORMAT='%h %^[%d:%t %^] "%r" %s %b "%R" "%u" %T %^'

# render <name> <logfile> <comma-separated self-hosts>
render() {
  local name=$1 log=$2 self_hosts=$3

  if [[ ! -r $log ]]; then
    echo "skip $name: $log not readable" >&2
    return 0
  fi

  # --db-path is a DIRECTORY (goaccess.conf: "Path where the persisted database
  # files are stored on disk"). It does NOT create it. Pass a missing dir and
  # the run dies with:
  #   src/persistence.c - set_db_path - 67
  #   Unable to open the specified db path/file '.../db'. No such file or directory
  # This is exactly how the first install failed. Create it BEFORE calling
  # goaccess, and do it here rather than in the installer so a manually deleted
  # state dir self-heals instead of breaking the timer silently.
  local dbdir="$STATE/$name/db"
  install -d -m 750 "$dbdir"

  # JSON sits beside it, private (state dir is 750 root) and never served.
  local json="$STATE/$name/referrers.json"

  goaccess "$log" \
    --log-format="$FORMAT" \
    --date-format='%d/%b/%Y' \
    --time-format='%H:%M:%S' \
    --no-global-config --persist --restore --db-path="$dbdir" \
    --ignore-crawlers \
    --exclude-ip=127.0.0.1 \
    --exclude-ip="$ORIGIN_IP" \
    -o "$json" >/dev/null

  if [[ ! -s $json ]]; then
    echo "ERROR: $name JSON not written" >&2
    return 1
  fi

  python3 /usr/local/bin/swanpan-referrals-render "$json" \
    "$OUT/referrals-$name.html" "$name" "$self_hosts"

  if [[ ! -s "$OUT/referrals-$name.html" ]]; then
    echo "ERROR: referrals-$name.html not written" >&2
    return 1
  fi
  echo "wrote $OUT/referrals-$name.html ($(wc -c < "$OUT/referrals-$name.html") bytes)"
}

# swanpan's own hosts. Everything else is genuinely external.
render swanpan "${LOG_DIR}/swanpan-prod.access.log" \
  'swanpan.io,www.swanpan.io,174.138.42.13'

# hoyoul serves four hostnames across two domains.
render hoyoul "${LOG_DIR}/hoyoul-prod.access.log" \
  'hoyoul.com,www.hoyoul.com,calebkang.com,www.calebkang.com,174.138.42.13'

# Staging excluded: noindex, and the traffic is our own testing.

chown -R www-data:www-data "$OUT"
